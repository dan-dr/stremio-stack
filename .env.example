# ==========================
# stremio-stack .env.example
# Device: ddyo on tailnet
# Pattern: bind containers to 127.0.0.1 and publish via `tailscale serve` (HTTPS)
# ==========================

# --- Base URL ---
HOST_BASE_URL=http://ddyo

# --- Ports (host-side) ---
AIOSTREAMS_PORT=3131
AIOMETADATA_PORT=3232
AIOLISTS_PORT=7000
SYNCIO_PORT_FE=3333
SYNCIO_PORT_BE=3334
# STREMIO_AI_SEARCH_PORT=7001
# STREMIO_TRAKT_ADDON_PORT=7002
STREMTHRU_PORT=8447
COMET_PORT=8989
MEDIAFUSION_PORT=8001
ZILEAN_PORT=8181
BROWSERLESS_PORT=4001
WATCHLY_PORT=4005

# --- Postgres (shared) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# DBs inside Postgres (created by initdb script)
COMET_DB=comet
ZILEAN_DB=zilean
TRAKT_DB=trakt
MEDIAFUSION_DB=mediafusion

# --- Real Debrid ---
REAL_DEBRID_API_KEY=

# --- AIOStreams (required) ---
# Docs: https://raw.githubusercontent.com/Viren070/AIOStreams/main/.env.sample
AIOSTREAMS_ADDON_NAME=AIOStreams
AIOSTREAMS_ADDON_ID=aiostreams
# MUST be 64 hex chars: `openssl rand -hex 32`
AIOSTREAMS_SECRET_KEY=
# Optional password(s) for using your AIOStreams addon
AIOSTREAMS_ADDON_PASSWORD=
# Published HTTPS URL (via tailscale serve on :443)
AIOSTREAMS_BASE_URL=${HOST_BASE_URL}:${AIOSTREAMS_PORT}

# --- AIOMetadata ---
# Docs: https://github.com/cedya77/aiometadata
AIOMETADATA_HOST_NAME=${HOST_BASE_URL}:${AIOMETADATA_PORT}

# --- Metadata Providers (AIOMetadata / AIOLists) ---
# Docs: https://github.com/cedya77/aiometadata
# Docs: https://github.com/SebastianMorel/AIOLists#environment-configuration
TVDB_API_KEY=
FANART_API_KEY=
RPDB_API_KEY=
MDBLIST_API_KEY=
GEMINI_API_KEY=
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# --- AIOLists ---
# Docs: https://github.com/SebastianMorel/AIOLists#environment-configuration
# must match the oauth redirect expected by AIOLists if you use TMDB connect
TMDB_REDIRECT_URI=${HOST_BASE_URL}:${AIOLISTS_PORT}

# --- Trakt (used by AI Search + Trakt addon) ---
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# --- StremThru ---
# Docs: https://github.com/MunifTanjim/stremthru
STREMTHRU_STORE_NAME=
STREMTHRU_VAULT_SECRET=
STREMTHRU_BASE_URL=${HOST_BASE_URL}:${STREMTHRU_PORT}

# --- MediaFusion ---
# Docs: https://github.com/mhdzumair/MediaFusion/blob/main/docs/configuration.md
# must be exactly 32 characters
MEDIAFUSION_SECRET_KEY=
MEDIAFUSION_API_PASSWORD=
MEDIAFUSION_HOST_URL=${HOST_BASE_URL}:${MEDIAFUSION_PORT}

# --- Comet ---
# Docs: https://github.com/g0ldyy/comet
COMET_ADMIN_PASSWORD=

# --- Watchly ---
# Docs: https://stremio-addons.net/addons/watchly
WATCHLY_TOKEN_SALT=

# --- Syncio ---
# Docs: https://github.com/iamneur0/syncio#environment-variables
SYNCIO_JWT_SECRET=
SYNCIO_ENCRYPTION_KEY=

# --- Stremio Trakt Addon (scrobble) ---
# STREMIO_TRAKT_ADDON_BASE_URL=${HOST_BASE_URL}:${STREMIO_TRAKT_ADDON_PORT}
# STREMIO_AI_ENCRYPTION_KEY=
