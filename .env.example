# ==========================
# stremio-stack .env.example
# Device: ddyo on tailnet
# Pattern: bind containers to 127.0.0.1 and publish via `tailscale serve` (HTTPS)
# ==========================

HOST_BASE_URL=http://ddyo

# --- local bind ports (host-side) ---
AIOSTREAMS_PORT=3131
AIOMETADATA_PORT=3232
# STREMIO_AI_SEARCH_PORT=7001
# STREMIO_TRAKT_ADDON_PORT=7002
STREMTHRU_PORT=8447
COMET_PORT=8989
MEDIAFUSION_PORT=8001
#ZILEAN_PORT=8181
WATCHLY_PORT=4005
NZBHYDRA2_PORT=5076
USENETSTREAMER_PORT=4006

# --- consolidated Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_PORT=5432

# FerretDB is on postgres db because
# of pg_cron and extension beind installed on it
FERRETDB_DB=postgres

# DBs inside Postgres (created by initdb script)
COMET_DB=comet
ZILEAN_DB=zilean
TRAKT_DB=trakt
MEDIAFUSION_DB=mediafusion

# --- Real Debrid ---
REAL_DEBRID_API_KEY=

# --- AIOStreams (required) ---
# (pinned in compose.yaml)
AIOSTREAMS_ADDON_NAME=AIOStreams
AIOSTREAMS_ADDON_ID=aiostreams.ddyo
# MUST be 64 hex chars: `openssl rand -hex 32`
AIOSTREAMS_SECRET_KEY=
# Optional basic-auth users for the AIOStreams dashboard/proxy: user:password,user2:password2
AIOSTREAMS_AUTH=

# Published HTTPS URL (via tailscale serve on :443)
AIOSTREAMS_BASE_URL=${HOST_BASE_URL}:${AIOSTREAMS_PORT}

# AIOStreams addon proxy for Torrentio (*.strem.fun) via a Tailscale exit node.
# Create a reusable/ephemeral auth key in Tailscale, then set the exit node to
# a Tailnet device name or 100.x.y.z address that is approved as an exit node.
AIOSTREAMS_ADDON_PROXY_CONFIG=*:false,*.strem.fun:true
TAILSCALE_ADDON_PROXY_AUTHKEY=
TAILSCALE_ADDON_PROXY_HOSTNAME=stremio-addon-proxy
TAILSCALE_ADDON_PROXY_EXIT_NODE=

# --- AIOMetadata / AIOLists ---
AIOMETADATA_HOST_NAME=${HOST_BASE_URL}:${AIOMETADATA_PORT}
TVDB_API_KEY=
FANART_API_KEY=
RPDB_API_KEY=
MDBLIST_API_KEY=
GEMINI_API_KEY=
TMDB_API_KEY=

# --- UsenetStreamer ---
USENETSTREAMER_BASE_URL=${HOST_BASE_URL}:${USENETSTREAMER_PORT}
USENETSTREAMER_SHARED_SECRET=
USENETSTREAMER_STREAMING_MODE=native
NZBHYDRA2_API_KEY=

# --- Trakt (used by AI Search + Trakt addon) ---
TRAKT_CLIENT_ID=
TRAKT_CLIENT_SECRET=

# --- StremThru ---
STREMTHRU_STORE_NAME=realdebrid
STREMTHRU_VAULT_SECRET=
STREMTHRU_BASE_URL=${HOST_BASE_URL}:${STREMTHRU_PORT}

# --- MediaFusion ---
# must be exactly 32 characters
MEDIAFUSION_SECRET_KEY=
MEDIAFUSION_API_PASSWORD=
MEDIAFUSION_HOST_URL=${HOST_BASE_URL}:${MEDIAFUSION_PORT}

# --- Comet ---
COMET_ADMIN_PASSWORD=

# Misc
WATCHLY_TOKEN_SALT=
WATCHLY_HOST_NAME=

SYNCIO_JWT_SECRET=
SYNCIO_ENCRYPTION_KEY=

# --- Stremio Trakt Addon (scrobble) ---
# STREMIO_TRAKT_ADDON_BASE_URL=${HOST_BASE_URL}:${STREMIO_TRAKT_ADDON_PORT}
# STREMIO_AI_ENCRYPTION_KEY=
